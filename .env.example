# Local development. Copy to .env (git-ignored). Services from infra/compose/dev.yml.
APP_ENV=development
APP_URL=http://localhost:3000
SITE_NAME=Newsmedia
LOG_LEVEL=debug
# Leave schedules off in dev; run work on demand from the admin or the worker CLI.
SCHEDULER_ENABLED=false

DATABASE_URL=postgres://newsmedia:newsmedia@localhost:5432/newsmedia

# Ingestion
# INGEST_USER_AGENT=NewsmediaBot/1.0 (+http://localhost:3000/bot)
INGEST_CONCURRENCY=4
INGEST_TIMEOUT_MS=15000
INGEST_MIN_TEXT_LENGTH=400

# Media (images). Served by Next.js in dev, by Caddy on the VPS.
# Relative to apps/web and apps/worker, i.e. <repo>/data/media (also mounted into dev containers)
STORAGE_LOCAL_DIR=../../data/media
MEDIA_BASE_URL=/media

# AI rewrite & translation — Claude Haiku by default
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# Optional fallback through any OpenAI-compatible API:
# LLM_FALLBACK_PROVIDER=openai
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=deepseek-chat
# Prices of the primary model in USD per million tokens (Haiku 4.5 defaults)
LLM_INPUT_PRICE_PER_MTOK=1
LLM_OUTPUT_PRICE_PER_MTOK=5
# Spend guards — keep dev tiny
LLM_MAX_ARTICLES_PER_RUN=5
LLM_MONTHLY_BUDGET_USD=5
# DEEPL_API_KEY=

# Search — leave TYPESENSE_URL empty to use the PostgreSQL fallback
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=dev-typesense-key

# Accounts & e-mail (Mailpit catches everything locally)
SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Newsmedia <no-reply@localhost>
# Outside production only these addresses receive e-mail/push:
NOTIFY_ALLOWLIST=you@example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Web push — generate with: pnpm --filter @nm/worker cli generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@seweb.co
DIGEST_HOUR=7
DIGEST_TIMEZONE=Europe/Sofia

# Operations (all optional locally)
# SENTRY_DSN=
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL=
