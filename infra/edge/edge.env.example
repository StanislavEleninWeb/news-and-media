ACME_EMAIL=ops@seweb.co
PROD_DOMAIN=news.example.com
STAGING_DOMAIN=staging.news.example.com
# Lets internal mobile builds through staging basic auth (header X-Staging-Key).
# REQUIRED when STAGING_DOMAIN is set — a long random value: openssl rand -hex 32
# Put the same value in the EAS secret EXPO_PUBLIC_STAGING_KEY.
STAGING_APP_KEY=change-me-to-a-long-random-value
