# /srv/newsmedia/<environment>/.env on the VPS — never committed.
# Staging and production each get their own copy with their own secrets.

APP_ENV=production                      # production | staging
APP_URL=https://news.example.com
SITE_NAME=Newsmedia
LOG_LEVEL=info
# Automatic schedules (ingestion, AI processing, digests). Defaults to true only in production.
# SCHEDULER_ENABLED=true

# Images built by GitHub Actions. deploy.sh sets IMAGE_TAG to the commit SHA.
IMAGE_PREFIX=ghcr.io/stanislaveleninweb/news-and-media
DATA_DIR=/srv/newsmedia/production/data

POSTGRES_DB=newsmedia
POSTGRES_USER=newsmedia
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://newsmedia:change-me-long-random@postgres:5432/newsmedia

# Ingestion
INGEST_CONCURRENCY=4
INGEST_TIMEOUT_MS=15000
INGEST_MIN_TEXT_LENGTH=400

# Media — inside the containers; the host path is ${DATA_DIR}/media
STORAGE_LOCAL_DIR=/data/media
MEDIA_BASE_URL=/media

# AI rewrite & translation — Claude Haiku by default
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# Optional fallback through any OpenAI-compatible API:
# LLM_FALLBACK_PROVIDER=openai
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=deepseek-chat
# Prices of the primary model in USD per million tokens (Haiku 4.5 defaults)
LLM_INPUT_PRICE_PER_MTOK=1
LLM_OUTPUT_PRICE_PER_MTOK=5
# Spend guards (staging: use its own API key with a low limit in the Anthropic console too)
LLM_MAX_ARTICLES_PER_RUN=50
LLM_MONTHLY_BUDGET_USD=50
# Optional: DeepL for flagship articles (free keys end in ":fx")
# DEEPL_API_KEY=

# Search (the typesense container uses the same key)
TYPESENSE_URL=http://typesense:8108
TYPESENSE_API_KEY=change-me-long-random

# Accounts & e-mail
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Newsmedia <no-reply@news.example.com>
# Staging: only these addresses receive e-mail/push (ignored in production)
NOTIFY_ALLOWLIST=
# Optional "Sign in with Google" (redirect URI: <APP_URL>/api/v1/auth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Web push (one key pair per environment):
#   docker compose ... run --rm worker node dist/cli.js generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@seweb.co
# Mobile app push via Expo (→ FCM / APNs). Access token only if "enhanced push security" is on.
NATIVE_PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
# Daily briefing
DIGEST_HOUR=7
DIGEST_TIMEZONE=Europe/Sofia
DIGEST_SIZE=8

# Operations
SENTRY_DSN=
ALERT_WEBHOOK_URL=
ALERT_EMAIL=ops@seweb.co
# Off-site backups with rclone (optional), used by backup.sh
# RCLONE_REMOTE=b2:newsmedia-backups

# "Ask this article" — the only request-time LLM call. Its own key so the spend is
# metered and capped separately from the pipeline; chat stays off until it is set.
CHAT_ANTHROPIC_API_KEY=
CHAT_LLM_MODEL=claude-haiku-4-5-20251001
CHAT_MONTHLY_BUDGET_USD=20
CHAT_MAX_PER_HOUR=20
CHAT_MAX_PER_DAY=60
# Reading signals used for personalisation are deleted after this many days.
ENGAGEMENT_RETENTION_DAYS=90

# Advertising: "direct" (built-in ads, default) or "gam" (Google Ad Manager).
ADS_PROVIDER=direct
GAM_NETWORK_CODE=
GAM_AD_UNIT_PREFIX=news
# Google CMP from Ad Manager → Privacy & messaging (needed for personalised/programmatic EEA demand).
GAM_CMP_SCRIPT_URL=
# Optional header bidding: self-hosted Prebid build + bidders per placement (JSON).
PREBID_SCRIPT_URL=
PREBID_TIMEOUT_MS=1000
PREBID_BIDDERS=
# /ads.txt lines separated by "|"
ADS_TXT=
