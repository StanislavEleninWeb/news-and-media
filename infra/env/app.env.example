# /srv/newsmedia/<environment>/.env on the VPS — never committed.
# Staging and production each get their own copy with their own secrets.

APP_ENV=production                      # production | staging
APP_URL=https://news.example.com
SITE_NAME=Newsmedia
LOG_LEVEL=info
# Automatic schedules (ingestion, AI processing, digests). Defaults to true only in production.
# SCHEDULER_ENABLED=true

# Images built by GitHub Actions. deploy.sh sets IMAGE_TAG to the commit SHA.
IMAGE_PREFIX=ghcr.io/stanislaveleninweb/news-and-media
DATA_DIR=/srv/newsmedia/production/data

POSTGRES_DB=newsmedia
POSTGRES_USER=newsmedia
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://newsmedia:change-me-long-random@postgres:5432/newsmedia

# Ingestion
INGEST_CONCURRENCY=4
INGEST_TIMEOUT_MS=15000
INGEST_MIN_TEXT_LENGTH=400

# Media — inside the containers; the host path is ${DATA_DIR}/media
STORAGE_LOCAL_DIR=/data/media
MEDIA_BASE_URL=/media
